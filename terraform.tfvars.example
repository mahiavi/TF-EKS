# Example Terraform variables file
# Copy this to terraform.tfvars and update with your values

aws_region     = "us-east-1"
cluster_name   = "production-eks"
cluster_version = "1.29"
environment    = "production"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

enable_nat_gateway = true
single_nat_gateway = false  # Set to true for cost savings in dev/test environments

enable_dns_hostnames = true
enable_dns_support   = true

# Node Group Configuration
node_group_name    = "production-node-group"
node_desired_size  = 3
node_min_size      = 2
node_max_size      = 6
node_instance_types = ["t3.medium"]  # Use t3.medium for dev, t3.large or larger for production
node_disk_size     = 50

enable_cluster_autoscaling = true
enable_monitoring         = true

# Tags
tags = {
  Environment = "production"
  ManagedBy   = "Terraform"
  Project     = "EKS-Infrastructure"
}
